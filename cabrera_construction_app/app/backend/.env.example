# Copy to .env and fill in. .env is gitignored — never commit real secrets.
# Use these exact values for local dev. When deploying to Cloud Run
# (app.cabrera.construction), use a separate set of env vars there with the
# production values shown commented out below — see CLAUDE.md "Production
# deployment" for the full Cloud Run + Cloud SQL runbook.

# From developer.intuit.com -> your app -> Keys & OAuth
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=
# Must exactly match a redirect URI registered on the app (Production keys tab).
# Intuit allows http://localhost for local dev even with Production keys —
# register BOTH this one and the production one below under Keys & OAuth.
QUICKBOOKS_REDIRECT_URI=http://localhost:8000/api/integrations/quickbooks/callback
# Production: QUICKBOOKS_REDIRECT_URI=https://app.cabrera.construction/api/integrations/quickbooks/callback
# "production" or "sandbox" — must match which keys you pasted above.
QUICKBOOKS_ENVIRONMENT=production

# From console.cloud.google.com -> your project -> APIs & Services -> Credentials
# -> your OAuth client. Same pattern as QuickBooks above — register both
# redirect URIs (local + production) on the OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/google/callback
# Production: GOOGLE_REDIRECT_URI=https://app.cabrera.construction/api/integrations/google/callback

# Optional — summarizes the QuickBooks estimate description into a clean
# project scope via Gemini. A plain API key from aistudio.google.com/apikey
# (different product from the Drive/Sheets OAuth client above). Leave unset
# to skip summarization and use the raw QuickBooks text as-is.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Where the frontend lives — used to build the redirect-back URL after OAuth.
# In production this is the SAME origin as the backend (FastAPI serves both
# the API and the built frontend from one Cloud Run service — see main.py).
FRONTEND_BASE_URL=http://localhost:5173
# Production: FRONTEND_BASE_URL=https://app.cabrera.construction

# Only needed because local dev runs frontend (:5173) and backend (:8000) as
# separate origins. Production is same-origin, so CORS isn't load-bearing
# there, but it's harmless to set anyway:
# Production: CORS_ORIGINS=["https://app.cabrera.construction"]

# Production only — path to the frontend's built static files inside the
# container (see app/Dockerfile). Leave unset for local dev.
# Production: FRONTEND_DIST_DIR=/app/frontend_dist
